				</dict>
				<key>AMActionVersion</key>
				<string>2.0.3</string>
				<key>AMApplication</key>
				<array>
					<string>Automator</string>
				</array>
				<key>AMCategory</key>
				<string>AMCategoryUtilities</string>
				<key>AMIconName</key>
				<string>Automator</string>
				<key>AMName</key>
				<string>Run Shell Script</string>
				<key>AMParameters</key>
				<dict>
					<key>COMMAND_STRING</key>
					<string>#!/bin/bash

# Add Homebrew paths (Apple Silicon and Intel)
export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"

# Strip GPS Metadata from Images
# This script removes GPS/location data from image files

# Check if exiftool is installed
if ! command -v exiftool &amp;&gt; /dev/null; then
    osascript -e 'display dialog "exiftool is not installed.\n\nTo install it, open Terminal and run:\nbrew install exiftool\n\nIf you do not have Homebrew, visit:\nhttps://brew.sh" buttons {"OK"} default button "OK" with title "Strip GPS Metadata" with icon stop'
    exit 1
fi

# Process each file passed as argument
processed=0
failed=0

for file in "$@"; do
    if [ -f "$file" ]; then
        # Remove GPS and location-related metadata, overwrite original
        if exiftool -overwrite_original \
            -gps:all= \
            -xmp:GPSLatitude= \
            -xmp:GPSLongitude= \
            -xmp:GPSAltitude= \
            -xmp:GPSDateTime= \
            -xmp:GPSTimeStamp= \
            -xmp:GPSMapDatum= \
            -xmp:GPSDestLatitude= \
            -xmp:GPSDestLongitude= \
            -xmp:Location= \
            -xmp:LocationShownCity= \
            -xmp:LocationShownCountryCode= \
            -xmp:LocationShownCountryName= \
            -xmp:LocationShownProvinceState= \
            -xmp:LocationShownSublocation= \
            -xmp:LocationCreatedCity= \
            -xmp:LocationCreatedCountryCode= \
            -xmp:LocationCreatedCountryName= \
            -xmp:LocationCreatedProvinceState= \
            -xmp:LocationCreatedSublocation= \
            -IPTC:City= \
            -IPTC:Country-PrimaryLocationCode= \
            -IPTC:Country-PrimaryLocationName= \
            -IPTC:Province-State= \
            -IPTC:Sub-location= \
            "$file" 2&gt;/dev/null; then
            ((processed++))
        else
            ((failed++))
        fi
    fi
done

# Show completion notification
if [ $processed -gt 0 ]; then
    if [ $processed -eq 1 ]; then
        msg="GPS metadata stripped from 1 image."
    else
        msg="GPS metadata stripped from $processed images."
    fi
    if [ $failed -gt 0 ]; then
        msg="$msg\n$failed file(s) could not be processed."
    fi
    osascript -e "display notification \"$msg\" with title \"Strip GPS Metadata\""
elif [ $failed -gt 0 ]; then
    osascript -e 'display notification "Failed to process files." with title "Strip GPS Metadata"'
fi</string>
					<key>CheckedForUserDefaultShell</key>
